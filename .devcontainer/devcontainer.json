// Dev container for Ronin. Mirrors CI (Ubuntu 24.04, Node 24, Rust stable)
// and the repository setup: global `vp`, then `vp i`.
// Contributor doc: docs/internals/devcontainer.md
{
  "name": "Ronin",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    // nodeGypDependencies (default true) brings python3/make/g++, which Linux
    // needs for node-pty's node-gyp fallback (its prebuilds are mac/win only).
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24"
    },
    // native/resource-monitor (edition 2024, needs stable >= 1.85). The server
    // degrades gracefully without the binary, but CI checks cargo fmt + test.
    "ghcr.io/devcontainers/features/rust:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "containerEnv": {
    // Keep runtime state inside the gitignored workspace .ronin directory.
    // An explicit --home-dir still wins.
    "T3CODE_HOME": "${containerWorkspaceFolder}/.ronin"
  },
  "mounts": [
    // vp keeps the pnpm content-addressable store and metadata cache under
    // ~/.cache/pnpm; this volume lets installs survive container rebuilds.
    "source=ronin-pnpm-store,target=/home/vscode/.cache/pnpm,type=volume",
    // Root node_modules holds the pnpm virtual store. Scope this volume by
    // devcontainerId so parallel checkouts do not share dependency trees.
    "source=ronin-node-modules-${devcontainerId},target=${containerWorkspaceFolder}/node_modules,type=volume"
  ],
  "onCreateCommand": "bash .devcontainer/on-create.sh",
  "updateContentCommand": "bash .devcontainer/update-content.sh",
  "forwardPorts": [5733, 13773],
  "portsAttributes": {
    "5733": {
      "label": "Ronin web (open via the pairing URL, not the bare origin)",
      "onAutoForward": "notify"
    },
    "13773": {
      "label": "Ronin server",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["docs/internals/devcontainer.md"]
    },
    "vscode": {
      "extensions": ["oxc.oxc-vscode", "rust-lang.rust-analyzer"],
      "settings": {
        // .repos is a large vendored read-only reference tree; watching it
        // burns CPU and file handles.
        "files.watcherExclude": {
          "**/.repos/**": true,
          "**/.ronin/**": true
        },
        "search.exclude": {
          "**/.repos": true
        }
      }
    }
  },
  "remoteUser": "vscode"
}
